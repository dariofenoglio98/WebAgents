{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hotel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "city": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "city"
      ],
      "additionalProperties": false
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "room": {
            "type": "string"
          },
          "rooms": {
            "type": "integer",
            "minimum": 1
          },
          "nights": {
            "type": "integer",
            "minimum": 1
          },
          "price_usd": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "room",
          "rooms",
          "nights",
          "price_usd"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    }
  },
  "required": [
    "hotel",
    "offers"
  ],
  "additionalProperties": false
}
