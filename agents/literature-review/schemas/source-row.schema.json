{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "text": {
      "type": "string",
      "maxLength": 200000
    }
  },
  "required": [
    "id",
    "text"
  ],
  "additionalProperties": false
}
