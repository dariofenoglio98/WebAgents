{
  "type": "object",
  "properties": {
    "paper": {
      "$ref": "paper.schema.json"
    },
    "record": {
      "$ref": "citation-record.schema.json"
    },
    "file_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        }
      ]
    }
  },
  "required": [
    "paper",
    "record",
    "file_id"
  ],
  "additionalProperties": false
}
