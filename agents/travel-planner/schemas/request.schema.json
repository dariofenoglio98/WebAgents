{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "hotel_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "maxLength": 2048
    }
  },
  "required": [
    "text",
    "notes",
    "hotel_url"
  ],
  "additionalProperties": false
}
