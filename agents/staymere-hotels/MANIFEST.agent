{
  "spec_version": "0.1",
  "package_id": "org.webagents.staymere-hotels",
  "name": "Staymere",
  "version": "0.1.0",
  "description": "A fictional hotel aggregator as a package another agent can ask: it searches the hotels it lists in a city for a stay and proposes one among them. All data is fictional; nothing is booked.",
  "publisher": {
    "id": "staymere",
    "name": "Staymere (fictional hotel aggregator)"
  },
  "created_at": "2026-11-15T12:00:00Z",
  "runtime": {
    "api": "agentpkg-runtime-v0",
    "minimum_version": "0.8.0"
  },
  "capabilities": [],
  "entrypoint": "workflow.v0",
  "graph": "graph.json",
  "policy": "policy/policy.json",
  "skills": [
    {
      "id": "hotel-advisor",
      "version": "0.1.0",
      "path": "skills/hotel-advisor/SKILL.md"
    }
  ],
  "tools": [
    {
      "id": "search-hotels",
      "path": "tools/search-hotels.tool.json"
    }
  ],
  "schemas": [
    {
      "id": "query",
      "path": "schemas/query.schema.json"
    },
    {
      "id": "found",
      "path": "schemas/found.schema.json"
    },
    {
      "id": "pick",
      "path": "schemas/pick.schema.json"
    },
    {
      "id": "result",
      "path": "schemas/result.schema.json"
    },
    {
      "id": "state",
      "path": "schemas/state.schema.json"
    }
  ],
  "model_requirements": {
    "tasks": [
      {
        "id": "propose",
        "capabilities": [
          "structured_output"
        ],
        "context_window": 16000,
        "preferred_tier": "reasoning"
      }
    ],
    "routing": "host",
    "fallback_policy": "deny",
    "extensions": {}
  },
  "evals": [],
  "attestations": [],
  "dependencies": [],
  "update": {
    "channel": "local",
    "locator": null
  },
  "extensions": {}
}
