{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Travel profile",
  "type": "object",
  "properties": {
    "home_airport": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "preferred_cabin": {
      "enum": [
        "economy",
        "business"
      ]
    },
    "prefer_nonstop": {
      "type": "boolean"
    },
    "preferred_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  },
  "required": [
    "home_airport",
    "preferred_cabin",
    "prefer_nonstop",
    "preferred_currency"
  ],
  "additionalProperties": false
}
