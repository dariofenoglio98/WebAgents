{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interpreted request",
  "type": "object",
  "properties": {
    "search": {
      "type": [
        "object",
        "null"
      ],
      "description": "One WebAir search, with origin, nonstop preference and cabin null when the request leaves them unstated, or null when the request cannot be one WebAir search.",
      "properties": {
        "origin": {
          "enum": [
            "BOS",
            "JFK",
            "ZRH",
            "GVA",
            "LHR",
            "KEF",
            null
          ]
        },
        "destination": {
          "type": "string",
          "enum": [
            "BOS",
            "JFK",
            "ZRH",
            "GVA",
            "LHR",
            "KEF"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "passengers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "nonstop_only": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "max_price_usd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100000
        },
        "cabin": {
          "enum": [
            "economy",
            "business",
            null
          ]
        }
      },
      "required": [
        "origin",
        "destination",
        "date",
        "passengers",
        "nonstop_only",
        "max_price_usd",
        "cabin"
      ],
      "additionalProperties": false
    },
    "unsupported_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 300
    },
    "needs_travel_profile": {
      "type": "boolean",
      "description": "True when the request leaves the departure airport unstated, or refers to the person's usual preferences, so the travel profile they grant should fill what is unstated."
    }
  },
  "required": [
    "search",
    "unsupported_reason",
    "needs_travel_profile"
  ],
  "additionalProperties": false
}
