{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebAir result",
  "type": "object",
  "properties": {
    "status": {
      "$ref": "status.schema.json"
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Model-written summary from WebAir's answers. No passenger identity or payment detail is ever in its input."
    },
    "interpreted_request": {
      "$ref": "plan.schema.json"
    },
    "selected_fare_id": {
      "$ref": "selection.schema.json#/properties/selected_fare_id"
    },
    "mentioned_fare_ids": {
      "$ref": "answer.schema.json#/properties/mentioned_fare_ids"
    },
    "refusal": {
      "$ref": "refusal.schema.json"
    },
    "booking": {
      "$ref": "booking-summary.schema.json"
    },
    "purchase": {
      "$ref": "purchase-result.schema.json"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "search": {
          "$ref": "search-outcome.schema.json"
        },
        "fare_rules": {
          "$ref": "fare-rules.schema.json"
        }
      },
      "required": [
        "search",
        "fare_rules"
      ],
      "additionalProperties": false
    },
    "notice": {
      "const": "Fictional WebAir demo: no real booking, payment or ticket."
    }
  },
  "required": [
    "status",
    "answer",
    "interpreted_request",
    "selected_fare_id",
    "mentioned_fare_ids",
    "refusal",
    "booking",
    "purchase",
    "evidence",
    "notice"
  ],
  "additionalProperties": false
}
