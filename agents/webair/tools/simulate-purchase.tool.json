{
  "spec_version": "0.1",
  "id": "simulate-purchase",
  "version": "0.1.0",
  "description": "WebAir semantic API: simulate paying one exact quote with a demo payment method. Fictional: no real transaction ever occurs and nothing is charged. Declared as the package's purchase boundary, so a host treats it as consequential.",
  "execution": "remote",
  "binding": "webair.simulate_purchase",
  "endpoint": "https://webair.example/api/v1/simulate_purchase",
  "method": "POST",
  "input_schema": "schemas/api/simulate_purchase.input.schema.json",
  "output_schema": "schemas/api/simulate_purchase.output.schema.json",
  "permissions": [
    "network.webair.booking"
  ],
  "domains": [
    "webair.example"
  ],
  "timeout_seconds": 20,
  "retries": 0,
  "side_effects": "write",
  "approval_required": true,
  "extensions": {}
}
