  "permissions": [
   {
    "description": "Call WebAir's semantic API (a fictional demo airline): search flights, read fare rules, request a booking quote and, only with the separate purchase permission, simulate a purchase.",
    "id": "network.webair",
    "kind": "network",
    "required": true,
    "resources": [
     "webagents-webair-production.up.railway.app"
    ]
   },
   {
    "description": "Read the travel profile you choose (home airport, preferred cabin, nonstop preference) when a request leaves those unstated. The profile becomes search criteria sent to WebAir; it is never shown to a model as a profile.",
    "id": "profile.travel",
    "kind": "personal.read",
    "required": false,
    "resources": [
     "personal.travel_profile"
    ]
   },
   {
    "description": "Read the passenger identity you choose (name and contact email) and send it to WebAir for a booking quote or a simulated purchase, and nowhere else. No model sees it.",
    "id": "identity.passenger",
    "kind": "personal.read",
    "required": false,
    "resources": [
     "personal.passenger_identity"
    ]
   },
   {
    "description": "Read which payment method you choose (an opaque demo identifier and a display label, never a card number) and send the identifier to WebAir with a simulated purchase, and nowhere else. No model sees it.",
    "id": "wallet.payment",
    "kind": "personal.read",
    "required": false,
    "resources": [
     "wallet.payment_method"
    ]
   },
   {
    "description": "Simulate purchasing the one exact quote a task names, with the payment method you choose. Fictional: WebAir performs no real transaction and charges nothing. Consequential by design: grant it once, for one run.",
    "id": "booking.simulate_purchase",
    "kind": "payment",
    "required": false,
    "resources": [
     "webagents-webair-production.up.railway.app"
    ]
   },
   {
    "description": "Use the host-selected model router to interpret the request, choose fares and write the answer.",
    "id": "model.reasoning",
    "kind": "model",
    "required": true,
    "resources": [
     "host-router"
    ]
   },
   {
    "description": "Read and write explicit worker state views for this run only.",
    "id": "memory.session",
    "kind": "memory",
    "required": true,
    "resources": [
     "session"
    ]
   }
  ]
