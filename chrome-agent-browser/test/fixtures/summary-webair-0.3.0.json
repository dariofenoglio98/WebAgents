    "worker": "Coordinator",
    "writes": [
     "/purchase_summary"
    ]
   },
   {
    "conditional": true,
    "depends_on": [
     "purchase-summary"
    ],
    "id": "purchase-result",
    "timeout_seconds": 10,
    "type": "validate",
    "worker": "Coordinator",
    "writes": [
     "/purchase_result"
    ]
   },
   {
    "conditional": true,
    "depends_on": [
     "check-confirmation"
    ],
    "id": "purchase-fares",
    "timeout_seconds": 10,
    "type": "validate",
    "worker": "Coordinator",
    "writes": [
     "/purchase_fares"
    ]
   },
   {
    "conditional": false,
    "depends_on": [
     "offered-fares",
     "purchase-fares"
    ],
    "id": "known-fares",
    "timeout_seconds": 10,
    "type": "join",
    "worker": "Coordinator",
    "writes": [
     "/known_fares"
    ]
   },
   {
    "conditional": true,
    "depends_on": [
     "select"
    ],
    "id": "status",
    "timeout_seconds": 10,
    "type": "validate",
    "worker": "Coordinator",
    "writes": [
     "/status"
    ]
   },
   {
    "conditional": false,
    "depends_on": [
     "fare-rules",
     "check-no-flights",
     "check-not-searched",
     "refusal",
     "booking-summary",
     "purchase-summary"
    ],
    "id": "answer",
    "max_output_tokens": 8000,
    "task": "answer",
    "timeout_seconds": 300,
    "type": "llm",
    "worker": "Writer",
    "writes": [
     "/answer"
    ]
   },
   {
    "conditional": false,
    "depends_on": [
     "answer",
     "status",
     "known-fares",
     "purchase-result"
    ],
    "id": "assemble",
    "timeout_seconds": 10,
    "type": "validate",
    "worker": "Coordinator",
    "writes": [
     "/result"
    ]
   },
   {
    "conditional": false,
    "depends_on": [
     "assemble"
    ],
    "id": "scrub",
    "timeout_seconds": 10,
    "type": "validate",
    "worker": "Coordinator",
    "writes": [
     "/booking_request",
     "/confirmation",
     "/passenger",
     "/payment",
     "/profile",
     "/purchase_request",
     "/quote"
    ]
   },
   {
    "conditional": false,
    "depends_on": [
     "scrub"
    ],
    "id": "output",
    "timeout_seconds": 10,
    "type": "output",
    "worker": "Coordinator",
    "writes": []
   }
