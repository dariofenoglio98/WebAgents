{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "joined": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "result": {
      "anyOf": [
        {
          "$ref": "offers-result.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "joined",
    "reason",
    "result"
  ],
  "additionalProperties": false
}
