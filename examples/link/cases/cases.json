{
  "schema": "webagents-enforcement-cases-v0",
  "family": "link",
  "title": "link.v0 enforcement cases (spec/link-v0.md section 10)",
  "probe": "agentpkg/tests/link_probe.py",
  "stages": {
    "validation": "the caller's package is refused when it is validated; the message starts with the code",
    "prepare": "the caller's links are refused when they are resolved, decided or composed, before the run; the message starts with the code",
    "grants": "the grant check of the execution host refuses the linked package's grants",
    "host": "the execution host refuses the plan it was handed, before anything runs",
    "run": "the run fails with the code at the node named, or the control completes"
  },
  "cases": [
    {
      "id": "minimum-version",
      "title": "A link step in a package that declares an older runtime",
      "stage": "validation",
      "code": "link_minimum_version",
      "variant": "minimum-version"
    },
    {
      "id": "dependency-unknown",
      "title": "A link step names a dependency the manifest does not declare",
      "stage": "validation",
      "code": "link_dependency_unknown",
      "variant": "dependency-unknown"
    },
    {
      "id": "dependency-duplicate",
      "title": "Two dependency records under one id",
      "stage": "validation",
      "code": "link_dependency_duplicate",
      "variant": "dependency-duplicate"
    },
    {
      "id": "dependency-unused",
